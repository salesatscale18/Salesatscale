# Copy to .env.local for local development. Never commit real values.
# On Vercel, DATABASE_URL and the Clerk keys are injected by the Neon and Clerk
# Marketplace integrations; SUPER_ADMIN_EMAILS must be added manually.

# Neon Postgres connection string
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated emails that get the super_admin role on sign-in
# e.g. alice@example.com,bob@example.com
SUPER_ADMIN_EMAILS=

# Public base URL used in invite links, e.g. https://app.example.com
# Optional: when unset, the request's host is used.
APP_URL=

# Agent (P4). The test lab and the agent need an Anthropic API key.
ANTHROPIC_API_KEY=
# Optional: model for new agent versions (default claude-opus-5-5).
AGENT_MODEL=

# Order forms and test payments (P5). Optional: when unset, secrets are derived
# from DATABASE_URL. Set them explicitly so links survive a database URL change.
ORDER_LINK_SECRET=
FAKE_PAYMENT_SECRET=
