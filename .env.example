# Copy to .env.local for local development. Never commit real values.
# On Vercel, DATABASE_URL and the Clerk keys are injected by the Neon and Clerk
# Marketplace integrations; SUPER_ADMIN_EMAILS must be added manually.

# Neon Postgres connection string
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated emails that get the super_admin role on sign-in
# e.g. alice@example.com,bob@example.com
SUPER_ADMIN_EMAILS=

# Public base URL used in invite links, e.g. https://app.example.com
# Optional: when unset, the request's host is used.
APP_URL=

# Agent (P4). The test lab and the agent need an Anthropic API key.
ANTHROPIC_API_KEY=
# Optional model ids per role (docs/ai.md). Defaults: agent claude-opus-5-5,
# pipeline claude-sonnet-5-5, pipeline_light claude-haiku-5-5.
AGENT_MODEL=
PIPELINE_MODEL=
PIPELINE_LIGHT_MODEL=
# Optional price corrections, USD per million tokens, JSON:
# {"claude-opus-5-5": {"input": 4, "output": 20, "cacheRead": 0.2, "cacheWrite5m": 5, "cacheWrite1h": 8}}
AI_PRICES=
# Optional exchange rates (units per USD) for spend caps in other currencies, JSON: {"ILS": 3.7}
AI_USD_FX=
# Optional development guard: at or over this total platform AI cost this month (USD),
# every model call refuses and the agent hands chats to a person. Unset = no guard.
AI_PLATFORM_MONTHLY_BUDGET_USD=

# Voice calls (live voice, lib/voice, docs/ai.md "Voice calls").
# VOICE_REALTIME: off (default, no calls) | scripted (free fake model, no cost) |
# live (PAID realtime model through the Vercel AI Gateway). Under CLAUDE.md, any
# live call in development or testing needs the owner's approval first.
VOICE_REALTIME=off
# Vercel AI Gateway key, used only when VOICE_REALTIME=live. A secret: set it in Vercel, never commit it.
AI_GATEWAY_API_KEY=
# Optional realtime model id (default google/gemini-3.8-live).
VOICE_MODEL=
# Optional: a shorter maximum call length in seconds (the platform maximum is 600).
VOICE_MAX_CALL_SECONDS=
# Development only: the local voice relay (scripts/voice-dev-server.ts), because the
# WebSocket route only works on Vercel. e.g. ws://localhost:8787/api/voice/socket
# Leave it unset on Vercel: calls then use wss://<host>/api/voice/socket.
VOICE_WS_URL=

# Order forms and test payments (P5). Optional: when unset, secrets are derived
# from DATABASE_URL. Set them explicitly so links survive a database URL change.
ORDER_LINK_SECRET=
FAKE_PAYMENT_SECRET=

# Payments: "test" (default) enables the fake provider and the buyer's Simulate
# buttons. Set to "live" once a real provider is connected.
PAYMENTS_MODE=test

# WhatsApp via Twilio (P6, decision D2). The platform's Twilio account: every
# seller's sender number lives in it. Both are secrets: set them in Vercel,
# never commit them. Without them WhatsApp stays off (webhooks answer 503).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Platform scheduler (Vercel Cron, vercel.json): /api/cron/follow-ups needs Bearer <CRON_SECRET>; unset = refused. Random, 16+ characters.
CRON_SECRET=

# SMS via Twilio (reach plan: every nudge to a buyer is one SMS with one short link
# to the web chat, /c/<code>). Uses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN above and
# APP_URL for the links and the delivery status callback.
# SMS_MODE: mock (default when unset; no network, each SMS is recorded on the lead
# as "not sent: mock") | test (real SMS only to SMS_TEST_NUMBERS, everyone else
# is handled as mock) | live (real SMS to every lead that passes the rules).
# Preview MUST stay mock (leave it unset or set SMS_MODE=mock): Preview shares
# the production database and must never send (the code also forces mock when
# VERCEL_ENV=preview). Real SMS cost money: under
# CLAUDE.md, a real test SMS in development needs the owner's approval first.
SMS_MODE=mock
# The Twilio Messaging Service (MG + 32 hex) that holds the registered alphanumeric
# sender. Required for test and live; not a secret. Without it nothing is sent.
TWILIO_SMS_MESSAGING_SERVICE_SID=
# Comma-separated E.164 numbers, e.g. +972501234567,+972541234567: the default
# test numbers (the only ones that get real SMS when SMS_MODE=test). An account
# that edits its list in Settings › Channels uses its own list instead.
SMS_TEST_NUMBERS=
# Hard stop: real SMS per day across the platform (default 50; 0 = none).
# Mock SMS do not count.
SMS_DAILY_CAP=
# The registered alphanumeric sender in that Messaging Service (up to 11 letters,
# e.g. PolarDemo), shown in Settings › Channels. Not a secret.
TWILIO_SMS_SENDER_NAME=
# "approved" once Twilio approved the sender name; anything else shows
# "registration pending" and keeps "Go live" disabled.
TWILIO_SMS_SENDER_STATUS=
# 1 = the agent's own SMS (follow-ups, the opener) are sent too. They are
# commercial (sender name, "פרסומת:", STOP by reply) and need a sender that can
# receive replies: off until the owner decides. Off = they post in the chat only.
SMS_AGENT_NUDGES=

# WhatsApp outbound (owner decision 20 Nov: off by default; the web chat is the
# conversation home and SMS brings the buyer back to it). 1 = on for the platform.
WHATSAPP_ENABLED=
